{%- comment -%}
  Atramenti Signature-Karte.
  Aufruf: {% render 'atr-signature-card', product: product, eyebrow: 'Signature Collection' %}
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign img = product.featured_media.preview_image
  assign family = product.metafields.atramenti.duftfamilie
  assign show_compare = false
  if variant.compare_at_price > variant.price
    assign show_compare = true
  endif
-%}

<article class="atr-sig__card">
  {%- comment -%} Flaechiger Link unter den Bedienelementen — kein Button im Link. {%- endcomment -%}
  <a href="{{ product.url }}" class="atr-sig__cardlink" aria-label="{{ product.title | escape }}"></a>

  <p class="atr-sig__eyebrow">{{ eyebrow | default: 'Signature Collection' }}</p>
  <h3 class="atr-sig__title">{{ product.title }}</h3>

  <div class="atr-sig__media">
    {%- if img -%}
      {{
        img
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 750px) 25vw, 72vw',
          widths: '300,400,600,800',
          alt: img.alt | default: product.title
      }}
    {%- endif -%}

    <button
      class="atr-sig__heart"
      type="button"
      aria-pressed="false"
      aria-label="Zur Merkliste hinzufügen"
      data-atr-heart
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <path
          d="M9 15.5S2.5 11.5 2.5 6.9A3.4 3.4 0 0 1 9 5.3a3.4 3.4 0 0 1 6.5 1.6c0 4.6-6.5 8.6-6.5 8.6Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        ></path>
      </svg>
    </button>
  </div>

  <div class="atr-sig__info">
    {%- if family != blank -%}
      <p class="atr-sig__family">{{ family }}</p>
    {%- endif -%}

    <p class="atr-sig__meta">
      {{ product.type | default: 'Eau de Parfum' }}
      {%- if variant.title != 'Default Title' %} · {{ variant.title }}{% endif -%}
    </p>

    <p class="atr-sig__price">
      <span>{{ variant.price | money }}</span>
      {%- if show_compare -%}
        <span class="atr-sig__compare">{{ variant.compare_at_price | money }}</span>
      {%- endif -%}
    </p>
  </div>

  {%- if variant.available -%}
    <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="atr-sig__form">
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="atr-btn atr-btn--outline atr-sig__cta">In den Warenkorb</button>
    </form>
  {%- else -%}
    <span class="atr-btn atr-btn--outline atr-sig__cta" aria-disabled="true">Ausverkauft</span>
  {%- endif -%}
</article>

<script>
  (function () {
    document.querySelectorAll('[data-atr-heart]').forEach(function (button) {
      if (button.dataset.bound) return;
      button.dataset.bound = '1';
      button.addEventListener('click', function () {
        var on = button.getAttribute('aria-pressed') === 'true';
        button.setAttribute('aria-pressed', String(!on));
        button.setAttribute(
          'aria-label',
          on ? 'Zur Merkliste hinzufügen' : 'Von der Merkliste entfernen'
        );
      });
    });
  })();
</script>
