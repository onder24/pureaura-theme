<section id="s5-root" style="padding:0; width:100%;">

  <!-- STATUS BAR -->
  <div class="s5-statusbar">
    <div class="s5-status-left">
      <span class="s5-led"></span>
      <span style="font-family:'Barlow',sans-serif;font-size:9px;letter-spacing:2px;color:var(--text-muted);text-transform:uppercase;">Label Studio</span>
    </div>
    <div style="font-family:'Barlow',sans-serif;font-size:9px;color:var(--s-400);">
      SET <span id="s5-set-indicator" style="color:var(--s-100);">01</span>
      <span style="color:var(--border-mid);">/</span>
      <span id="s5-total-indicator" style="color:var(--text-muted);">01</span>
    </div>
    <button class="s5-icon-btn" onclick="s5RandomAlchemy()" title="Zufalls-Design">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 3h3l3 8 2-4 2 4 1-3h1M1 11h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <!-- STICKY PREVIEW STAGE -->
  <div class="s5-stage-sticky">
    <div class="s5-stage" id="s5-stage">
      <div class="s5-grid-bg"></div>
      <div class="s5-label-wrap" id="s5-label-3d">
        <div class="s5-label" id="s5-physical-label" data-theme="onyx">
          <div class="s5-label-grain"></div>
          <div class="s5-label-inner">
            <div class="s5-label-row">
              <div class="s5-lmeta"><div class="s5-lkey">BATCH_ID</div><div class="s5-lval">#<span id="s5-batch">4401</span></div></div>
              <div class="s5-lmeta right"><div class="s5-lkey">DATE</div><div class="s5-lval" id="s5-date">—</div></div>
            </div>
            <div class="s5-label-center">
              <div class="s5-symbol" id="s5-symbol">☽</div>
              <h2 class="s5-title" id="s5-display-title">ALCHEMIST</h2>
              <div class="s5-ornament" id="s5-ornament"><div style="width:30px;height:1px;background:currentColor;margin:0 auto;"></div></div>
            </div>
            <div class="s5-label-row">
              <div class="s5-lmeta"><div class="s5-lkey">ORIGIN</div><div class="s5-lval">ESSEN / DE</div></div>
              <div class="s5-lmeta right"><div class="s5-lkey">CONTENT</div><div class="s5-lval">100ML</div></div>
            </div>
          </div>
        </div>
      </div>
      <div class="s5-scale-tag">LABEL PREVIEW · 1:1</div>
    </div>
  </div>

  <!-- CONTROL DASHBOARD -->
  <div class="s5-dashboard">

    <!-- NAME INPUT -->
    <div class="s5-section">
      <label class="s5-section-label">Dein Duftname</label>
      <div class="s5-input-wrap">
        <input id="label-input" type="text" maxlength="18"
               placeholder="Name eingeben..."
               oninput="s5HandleText(this.value)">
      </div>
    </div>

    <!-- LABEL THEME -->
    <div class="s5-section">
      <label class="s5-section-label">Label-Stil</label>
      <div class="s5-theme-grid" id="s5-theme-grid">
        <button class="s5-theme-card active" data-theme="onyx" onclick="s5SetTheme('onyx',this)">
          <div class="s5-theme-swatch" style="background:linear-gradient(135deg,#0e1a12,#070d09);border:1px solid rgba(200,212,204,0.18);"></div>
          <span>Onyx</span>
        </button>
        <button class="s5-theme-card" data-theme="alabaster" onclick="s5SetTheme('alabaster',this)">
          <div class="s5-theme-swatch" style="background:linear-gradient(135deg,#eff4f0,#e0e9e3);border:1px solid rgba(22,32,24,0.2);"></div>
          <span>Alabaster</span>
        </button>
        <button class="s5-theme-card" data-theme="midnight" onclick="s5SetTheme('midnight',this)">
          <div class="s5-theme-swatch" style="background:linear-gradient(135deg,#050818,#0a0f28);border:1px solid rgba(100,120,220,0.25);"></div>
          <span>Midnight</span>
        </button>
        <button class="s5-theme-card" data-theme="amber" onclick="s5SetTheme('amber',this)">
          <div class="s5-theme-swatch" style="background:linear-gradient(135deg,#1c1408,#2e2010);border:1px solid rgba(200,170,80,0.3);"></div>
          <span>Amber</span>
        </button>
        <button class="s5-theme-card" data-theme="rose" onclick="s5SetTheme('rose',this)">
          <div class="s5-theme-swatch" style="background:linear-gradient(135deg,#1a0c10,#2e0f18);border:1px solid rgba(200,80,110,0.3);"></div>
          <span>Rose Noir</span>
        </button>
        <button class="s5-theme-card" data-theme="sage" onclick="s5SetTheme('sage',this)">
          <div class="s5-theme-swatch" style="background:linear-gradient(135deg,#e8f0e8,#d4e4d4);border:1px solid rgba(60,100,60,0.2);"></div>
          <span>Sage</span>
        </button>
        <button class="s5-theme-card" data-theme="slate" onclick="s5SetTheme('slate',this)">
          <div class="s5-theme-swatch" style="background:linear-gradient(135deg,#0f1418,#1a2028);border:1px solid rgba(150,180,220,0.2);"></div>
          <span>Slate</span>
        </button>
        <button class="s5-theme-card" data-theme="gold" onclick="s5SetTheme('gold',this)">
          <div class="s5-theme-swatch" style="background:linear-gradient(135deg,#c9aa6e,#a88840);border:1px solid rgba(255,220,100,0.3);"></div>
          <span>Gold</span>
        </button>
      </div>
    </div>

    <!-- SYMBOL -->
    <div class="s5-section">
      <label class="s5-section-label">Symbol</label>
      <div class="s5-sym-grid">
        <button class="s5-sym active" onclick="s5SetSymbol('☽',this)">☽</button>
        <button class="s5-sym"        onclick="s5SetSymbol('☉',this)">☉</button>
        <button class="s5-sym"        onclick="s5SetSymbol('△',this)">△</button>
        <button class="s5-sym"        onclick="s5SetSymbol('◈',this)">◈</button>
        <button class="s5-sym"        onclick="s5SetSymbol('⬡',this)">⬡</button>
        <button class="s5-sym"        onclick="s5SetSymbol('✦',this)">✦</button>
        <button class="s5-sym"        onclick="s5SetSymbol('♦',this)">♦</button>
        <button class="s5-sym"        onclick="s5SetSymbol('✧',this)">✧</button>
        <button class="s5-sym"        onclick="s5SetSymbol('⊕',this)">⊕</button>
        <button class="s5-sym"        onclick="s5SetSymbol('◉',this)">◉</button>
        <button class="s5-sym"        onclick="s5SetSymbol('∞',this)">∞</button>
        <button class="s5-sym"        onclick="s5SetSymbol('⟡',this)">⟡</button>
      </div>
    </div>

    <!-- FONT -->
    <div class="s5-section">
      <label class="s5-section-label">Schrift</label>
      <div class="s5-font-grid">
        <button class="s5-font-card active" onclick="s5SetFont('cormorant',this)">
          <span class="s5-font-preview" style="font-family:'Cormorant Garamond',serif;font-size:22px;font-style:italic;">Aa</span>
          <span class="s5-font-name">Cormorant</span>
        </button>
        <button class="s5-font-card" onclick="s5SetFont('barlow',this)">
          <span class="s5-font-preview" style="font-family:'Barlow',sans-serif;font-size:17px;font-weight:200;letter-spacing:3px;">Aa</span>
          <span class="s5-font-name">Barlow</span>
        </button>
        <button class="s5-font-card" onclick="s5SetFont('georgia',this)">
          <span class="s5-font-preview" style="font-family:Georgia,serif;font-size:19px;">Aa</span>
          <span class="s5-font-name">Georgia</span>
        </button>
        <button class="s5-font-card" onclick="s5SetFont('mono',this)">
          <span class="s5-font-preview" style="font-family:monospace;font-size:13px;letter-spacing:2px;">Aa</span>
          <span class="s5-font-name">Mono</span>
        </button>
      </div>
    </div>

    <!-- LETTER SPACING -->
    <div class="s5-section">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
        <label class="s5-section-label" style="margin:0;">Buchstabenabstand</label>
        <span id="s5-kern-val" style="font-family:'Barlow',sans-serif;font-size:11px;color:var(--g-400);">4px</span>
      </div>
      <input type="range" min="0" max="16" value="4" class="s5-slider" oninput="s5UpdateSpacing(this.value)">
    </div>

    <!-- ORNAMENT -->
    <div class="s5-section">
      <label class="s5-section-label">Zierleiste</label>
      <div class="s5-orn-grid">
        <button class="s5-orn-btn active" data-orn="line"    onclick="s5SetOrnament('line',this)">
          <span class="s5-orn-pre"><span style="width:30px;height:1px;background:currentColor;display:block;"></span></span><span>Linie</span>
        </button>
        <button class="s5-orn-btn" data-orn="double" onclick="s5SetOrnament('double',this)">
          <span class="s5-orn-pre" style="flex-direction:column;gap:3px;"><span style="width:28px;height:1px;background:currentColor;display:block;"></span><span style="width:18px;height:1px;background:currentColor;display:block;"></span></span><span>Doppel</span>
        </button>
        <button class="s5-orn-btn" data-orn="diamond" onclick="s5SetOrnament('diamond',this)">
          <span class="s5-orn-pre" style="font-size:9px;letter-spacing:2px;">◇ ◇ ◇</span><span>Rauten</span>
        </button>
        <button class="s5-orn-btn" data-orn="dots" onclick="s5SetOrnament('dots',this)">
          <span class="s5-orn-pre" style="font-size:7px;letter-spacing:4px;">· · · · ·</span><span>Punkte</span>
        </button>
        <button class="s5-orn-btn" data-orn="wave" onclick="s5SetOrnament('wave',this)">
          <span class="s5-orn-pre" style="font-size:9px;letter-spacing:1px;font-family:serif;">∿∿∿∿∿</span><span>Welle</span>
        </button>
        <button class="s5-orn-btn" data-orn="none" onclick="s5SetOrnament('none',this)">
          <span class="s5-orn-pre" style="opacity:0.2;font-size:11px;">—</span><span>Keine</span>
        </button>
      </div>
    </div>

  </div>

  <!-- CONFIRM -->
  <footer class="s5-footer">
    <button class="s5-confirm-btn" id="s5-physical-label-btn" onclick="window.confirmLabel()">
      <div>
        <div class="s5-confirm-main">DESIGN BESTÄTIGEN</div>
        <div class="s5-confirm-sub">SET <span id="label-set-num-btn">1</span> FINALISIEREN</div>
      </div>
      <svg width="16" height="12" viewBox="0 0 16 12" fill="none"><path d="M1 6H15M10 1L15 6L10 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="s5-shimmer"></div>
    </button>
  </footer>

</section>

<style>
  .s5-statusbar {
    display:flex; justify-content:space-between; align-items:center;
    padding:12px 0 14px; border-bottom:1px solid var(--border-dim); margin-bottom:0;
  }
  .s5-status-left { display:flex; align-items:center; gap:8px; }
  .s5-led { width:6px; height:6px; border-radius:50%; background:var(--g-400); box-shadow:0 0 8px var(--g-400); animation:s5pulse 2s infinite; flex-shrink:0; }
  @keyframes s5pulse { 0%,100%{opacity:1} 50%{opacity:0.35} }
  .s5-icon-btn { width:32px; height:32px; border-radius:var(--r-sm); background:var(--bg-glass); border:1px solid var(--border-dim); color:var(--text-muted); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.25s; }
  .s5-icon-btn:hover { border-color:var(--border-accent); color:var(--g-400); }

  /* STICKY STAGE */
  .s5-stage-sticky {
    position: sticky; top: 0; z-index: 100;
    padding: 12px 0;
    background: rgba(8,14,10,0.94);
    backdrop-filter: blur(28px); -webkit-backdrop-filter: blur(28px);
    border-bottom: 1px solid rgba(74,158,116,0.1);
  }
  .s5-stage {
    width:100%; height:230px; background:#020503; border-radius:var(--r-xl);
    display:flex; justify-content:center; align-items:center; position:relative; overflow:hidden;
    border:1px solid var(--border-dim); max-width:460px; margin:0 auto;
  }
  .s5-grid-bg { position:absolute; inset:0; background-image:radial-gradient(rgba(74,158,116,0.09) 1px, transparent 1px); background-size:22px 22px; }
  .s5-scale-tag { position:absolute; bottom:10px; right:12px; font-family:'Barlow',sans-serif; font-size:7px; color:var(--text-muted); letter-spacing:2px; text-transform:uppercase; }
  .s5-label-wrap { transition:transform 0.1s ease-out; }

  /* LABEL */
  .s5-label { width:188px; height:234px; padding:11px; position:relative; box-shadow:0 30px 60px rgba(0,0,0,0.8); transition:all 0.45s var(--ease); }
  .s5-label[data-theme="onyx"]      { background:linear-gradient(160deg,#0e1a12,#070d09); color:#c8d8ce; border:1px solid rgba(200,212,204,0.15); }
  .s5-label[data-theme="alabaster"] { background:linear-gradient(160deg,#eff4f0,#e0e9e3); color:#1a2e1e; border:1px solid rgba(22,32,24,0.2); }
  .s5-label[data-theme="midnight"]  { background:linear-gradient(160deg,#06091e,#0d1030); color:#b0c0f0; border:1px solid rgba(100,120,220,0.25); }
  .s5-label[data-theme="amber"]     { background:linear-gradient(160deg,#1c1408,#2e2010); color:#e8c87a; border:1px solid rgba(200,170,80,0.3); }
  .s5-label[data-theme="rose"]      { background:linear-gradient(160deg,#1a0c10,#2a0d14); color:#f0b0c0; border:1px solid rgba(200,80,110,0.3); }
  .s5-label[data-theme="sage"]      { background:linear-gradient(160deg,#e8f0e8,#d4e4d4); color:#2a3e2a; border:1px solid rgba(60,100,60,0.2); }
  .s5-label[data-theme="slate"]     { background:linear-gradient(160deg,#0f1418,#1a2028); color:#a0c0e0; border:1px solid rgba(150,180,220,0.2); }
  .s5-label[data-theme="gold"]      { background:linear-gradient(160deg,#c9aa6e,#8a6830); color:#1a1008; border:1px solid rgba(255,220,100,0.4); }

  .s5-label-grain { position:absolute; inset:0; opacity:0.3; pointer-events:none; }
  .s5-label-inner { height:100%; display:flex; flex-direction:column; justify-content:space-between; padding:9px; border:1px solid transparent; }
  .s5-label[data-theme="onyx"]      .s5-label-inner { border-color:rgba(200,212,204,0.12); }
  .s5-label[data-theme="alabaster"] .s5-label-inner { border-color:rgba(26,46,30,0.18); }
  .s5-label[data-theme="midnight"]  .s5-label-inner { border-color:rgba(100,120,220,0.18); }
  .s5-label[data-theme="amber"]     .s5-label-inner { border-color:rgba(200,170,80,0.2); }
  .s5-label[data-theme="rose"]      .s5-label-inner { border-color:rgba(200,80,110,0.18); }
  .s5-label[data-theme="sage"]      .s5-label-inner { border-color:rgba(60,100,60,0.18); }
  .s5-label[data-theme="slate"]     .s5-label-inner { border-color:rgba(150,180,220,0.15); }
  .s5-label[data-theme="gold"]      .s5-label-inner { border-color:rgba(26,16,0,0.25); }

  .s5-label-row { display:flex; justify-content:space-between; }
  .s5-lmeta { display:flex; flex-direction:column; gap:2px; }
  .s5-lmeta.right { align-items:flex-end; }
  .s5-lkey { font-family:'Barlow',sans-serif; font-size:5px; opacity:0.4; letter-spacing:1.5px; text-transform:uppercase; }
  .s5-lval { font-family:'Barlow',sans-serif; font-size:6.5px; letter-spacing:1px; }
  .s5-label-center { text-align:center; }
  .s5-symbol { font-size:28px; margin-bottom:4px; transition:0.3s; }
  .s5-title  { font-family:'Cormorant Garamond',serif; font-size:18px; font-weight:300; font-style:italic; letter-spacing:4px; margin:4px 0; text-transform:uppercase; line-height:1.1; transition:all 0.3s; }
  .s5-ornament { margin:8px auto 0; text-align:center; opacity:0.4; transition:all 0.3s; min-height:8px; display:flex; align-items:center; justify-content:center; }

  /* DASHBOARD */
  .s5-dashboard { width:100%; padding:22px 0 160px; }
  .s5-section { margin-bottom:28px; }
  .s5-section-label { display:block; font-family:'Barlow',sans-serif; font-size:10px; font-weight:500; color:var(--text-muted); letter-spacing:2px; text-transform:uppercase; margin-bottom:12px; }

  .s5-input-wrap { position:relative; padding-bottom:10px; }
  .s5-input-wrap::after { content:''; position:absolute; bottom:0; left:0; right:0; height:1px; background:var(--border-dim); }
  .s5-input-wrap:focus-within::after { background:linear-gradient(to right, var(--g-400), transparent); }
  #label-input { background:none; border:none; color:var(--text-primary); width:100%; font-family:'Cormorant Garamond',serif; font-size:24px; font-weight:300; text-transform:uppercase; outline:none; letter-spacing:2px; }
  #label-input::placeholder { color:var(--text-muted); opacity:0.4; }

  .s5-theme-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
  .s5-theme-card { display:flex; flex-direction:column; align-items:center; gap:6px; background:none; border:1px solid var(--border-dim); border-radius:12px; padding:10px 6px; cursor:pointer; transition:all 0.25s; -webkit-tap-highlight-color:transparent; }
  .s5-theme-card:hover { border-color:rgba(74,158,116,0.3); }
  .s5-theme-card.active { border-color:var(--g-400); background:rgba(74,158,116,0.08); box-shadow:0 0 12px rgba(74,158,116,0.15); }
  .s5-theme-swatch { width:36px; height:36px; border-radius:8px; flex-shrink:0; }
  .s5-theme-card span:last-child { font-family:'Barlow',sans-serif; font-size:9px; color:var(--text-muted); letter-spacing:1px; white-space:nowrap; }
  .s5-theme-card.active span:last-child { color:var(--g-300); }

  .s5-sym-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:8px; }
  .s5-sym { background:var(--bg-2); border:1px solid var(--border-dim); color:var(--text-muted); font-size:18px; padding:10px 0; border-radius:var(--r-md); cursor:pointer; transition:all 0.25s; -webkit-tap-highlight-color:transparent; }
  .s5-sym.active { color:var(--text-primary); border-color:var(--border-accent); background:rgba(74,158,116,0.1); }

  .s5-font-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }
  .s5-font-card { display:flex; flex-direction:column; align-items:center; gap:4px; background:var(--bg-2); border:1px solid var(--border-dim); border-radius:12px; padding:12px 4px 10px; cursor:pointer; transition:all 0.25s; -webkit-tap-highlight-color:transparent; }
  .s5-font-card.active { border-color:var(--border-accent); background:rgba(74,158,116,0.08); }
  .s5-font-preview { color:var(--text-primary); line-height:1; }
  .s5-font-name { font-family:'Barlow',sans-serif; font-size:8px; color:var(--text-muted); letter-spacing:1px; }
  .s5-font-card.active .s5-font-name { color:var(--g-300); }

  .s5-slider { width:100%; appearance:none; background:var(--border-dim); height:2px; outline:none; border-radius:2px; }
  .s5-slider::-webkit-slider-thumb { appearance:none; width:18px; height:18px; background:var(--s-100); border-radius:50%; cursor:pointer; border:3px solid var(--bg); box-shadow:0 0 6px rgba(200,216,206,0.3); }

  .s5-orn-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
  .s5-orn-btn { display:flex; flex-direction:column; align-items:center; gap:8px; background:var(--bg-2); border:1px solid var(--border-dim); border-radius:10px; padding:12px 8px; cursor:pointer; transition:all 0.25s; -webkit-tap-highlight-color:transparent; color:var(--text-muted); font-family:'Barlow',sans-serif; font-size:9px; letter-spacing:1px; }
  .s5-orn-btn.active { border-color:var(--border-accent); background:rgba(74,158,116,0.08); color:var(--g-300); }
  .s5-orn-pre { height:16px; display:flex; align-items:center; justify-content:center; }

  .s5-footer { position:fixed; bottom:20px; left:0; width:100%; display:flex; justify-content:center; z-index:500; padding:0 16px; }
  .s5-confirm-btn { display:flex; align-items:center; gap:14px; justify-content:center; background:linear-gradient(135deg, var(--g-800), var(--g-600)); border:1px solid var(--border-accent); color:var(--text-primary); padding:18px 40px; border-radius:var(--r-full); cursor:pointer; position:relative; overflow:hidden; width:100%; max-width:460px; box-shadow:0 20px 40px rgba(0,0,0,0.5), var(--shadow-glow); transition:all 0.35s var(--ease); }
  .s5-confirm-btn:hover { background:linear-gradient(135deg,var(--g-700),var(--g-500)); transform:translateY(-2px); }
  .s5-confirm-main { font-size:11px; font-weight:700; letter-spacing:3px; font-family:'Barlow',sans-serif; }
  .s5-confirm-sub  { font-size:8px; opacity:0.5; margin-top:2px; font-family:'Barlow',sans-serif; letter-spacing:1px; }
  .s5-shimmer { position:absolute; inset:0; background:linear-gradient(105deg, transparent 30%, rgba(255,255,255,0.06) 50%, transparent 70%); transform:translateX(-100%); }
  .s5-confirm-btn:hover .s5-shimmer { transform:translateX(100%); transition:transform 0.55s ease; }
</style>

<script>
  const S5_ORNAMENTS = {
    line:    '<div style="width:30px;height:1px;background:currentColor;margin:0 auto;"></div>',
    double:  '<div style="width:28px;height:1px;background:currentColor;margin:0 auto 3px;"></div><div style="width:18px;height:1px;background:currentColor;margin:0 auto;"></div>',
    diamond: '<span style="font-size:7px;letter-spacing:3px;">◇ ◇ ◇</span>',
    dots:    '<span style="font-size:6px;letter-spacing:5px;">· · · · ·</span>',
    wave:    '<span style="font-size:9px;letter-spacing:1px;font-family:serif;">∿∿∿∿∿</span>',
    none:    ''
  };
  const S5_FONTS = {
    cormorant: { family:"'Cormorant Garamond',serif", weight:'300', style:'italic' },
    barlow:    { family:"'Barlow',sans-serif",         weight:'200', style:'normal' },
    georgia:   { family:"Georgia,serif",               weight:'400', style:'normal' },
    mono:      { family:"monospace",                   weight:'400', style:'normal' }
  };

  function initLabelStep() {
    const state = window.alchemistState;
    if (!state) return;
    document.getElementById('s5-set-indicator').innerText   = String(state.currentActiveSet).padStart(2,'0');
    document.getElementById('s5-total-indicator').innerText = String(state.totalSets).padStart(2,'0');
    document.getElementById('label-set-num-btn').innerText  = state.currentActiveSet;
    document.getElementById('s5-batch').innerText = Math.floor(4000 + Math.random()*999);
    const now = new Date();
    document.getElementById('s5-date').innerText = now.toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit',year:'2-digit'});
    s5AutoFit();
    s5InitParallax();
  }

  function s5HandleText(val) {
    const t = document.getElementById('s5-display-title');
    t.innerText = val.toUpperCase() || 'ALCHEMIST';
    s5AutoFit();
  }
  window.handleTextUpdate = s5HandleText;

  function s5AutoFit() {
    const title = document.getElementById('s5-display-title');
    if (!title) return;
    const parent = title.parentElement;
    let size = 20; title.style.fontSize = size + 'px';
    while (title.scrollWidth > parent.clientWidth && size > 8) { size--; title.style.fontSize = size + 'px'; }
  }

  function s5SetTheme(theme, el) {
    document.getElementById('s5-physical-label').dataset.theme = theme;
    el.closest('.s5-theme-grid').querySelectorAll('.s5-theme-card').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
  }

  function s5SetFont(style, el) {
    const title = document.getElementById('s5-display-title');
    const f = S5_FONTS[style];
    title.style.fontFamily = f.family; title.style.fontWeight = f.weight; title.style.fontStyle = f.style;
    el.closest('.s5-font-grid').querySelectorAll('.s5-font-card').forEach(b => b.classList.remove('active'));
    el.classList.add('active'); s5AutoFit();
  }

  function s5UpdateSpacing(val) {
    document.getElementById('s5-display-title').style.letterSpacing = val + 'px';
    document.getElementById('s5-kern-val').innerText = val + 'px';
    s5AutoFit();
  }

  function s5SetSymbol(sym, el) {
    document.getElementById('s5-symbol').innerText = sym;
    el.closest('.s5-sym-grid').querySelectorAll('.s5-sym').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
  }

  function s5SetOrnament(type, el) {
    document.getElementById('s5-ornament').innerHTML = S5_ORNAMENTS[type] || '';
    el.closest('.s5-orn-grid').querySelectorAll('.s5-orn-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
  }

  function s5InitParallax() {
    const stage = document.getElementById('s5-stage');
    const card  = document.getElementById('s5-label-3d');
    if (!stage || !card) return;
    stage.addEventListener('mousemove', e => {
      const r = stage.getBoundingClientRect();
      card.style.transform = `rotateX(${((e.clientY-r.top)-r.height/2)/14}deg) rotateY(${(r.width/2-(e.clientX-r.left))/14}deg)`;
    });
    stage.addEventListener('mouseleave', () => { card.style.transform = 'rotateX(0) rotateY(0)'; });
    stage.addEventListener('touchmove', e => {
      const t = e.touches[0], r = stage.getBoundingClientRect();
      card.style.transform = `rotateX(${((t.clientY-r.top)-r.height/2)/18}deg) rotateY(${(r.width/2-(t.clientX-r.left))/18}deg)`;
    }, {passive:true});
    stage.addEventListener('touchend', () => { card.style.transform = 'rotateX(0) rotateY(0)'; });
  }

  function s5RandomAlchemy() {
    const names  = ['LUNA','NOIR','AURORA','TERRA','ETHER','IGNIS','AQUA','SYLVA','UMBRA','AURA','SOLEIL','NOCTE'];
    const themes = ['onyx','midnight','amber','rose','sage','slate','alabaster','gold'];
    const syms   = ['☽','☉','△','◈','⬡','✦','♦','✧','⊕','◉','∞','⟡'];
    const name   = names[Math.floor(Math.random()*names.length)];
    const theme  = themes[Math.floor(Math.random()*themes.length)];
    const sym    = syms[Math.floor(Math.random()*syms.length)];
    const input  = document.getElementById('label-input');
    if (input) { input.value = name; s5HandleText(name); }
    document.getElementById('s5-symbol').innerText = sym;
    document.getElementById('s5-physical-label').dataset.theme = theme;
    document.querySelectorAll('.s5-theme-card').forEach(b => b.classList.toggle('active', b.dataset.theme === theme));
    document.querySelectorAll('.s5-sym').forEach(b => b.classList.toggle('active', b.innerText === sym));
    if (window.showToast) showToast(name + ' · ' + theme, 'success');
  }

  window.confirmLabel = function() {
    const state = window.alchemistState;
    const current = state.currentActiveSet;
    const t = document.getElementById('s5-display-title');
    const l = document.getElementById('s5-physical-label');
    const s = document.getElementById('s5-symbol');
    state.sets[current].label = { title: t?.innerText||'ALCHEMIST', theme: l?.dataset.theme||'onyx', symbol: s?.innerText||'☽' };
    if (current < state.totalSets) {
      state.currentActiveSet++;
      if (window.showToast) showToast(`Set ${current} finalisiert ✓`, 'success');
      document.getElementById('label-set-num-btn').innerText = state.currentActiveSet;
      document.getElementById('s5-set-indicator').innerText = String(state.currentActiveSet).padStart(2,'0');
      const input = document.getElementById('label-input');
      if (input) input.value = '';
      if (t) t.innerText = 'ALCHEMIST';
      if (window.typeWriter) typeWriter(`Etikett für Set ${state.currentActiveSet} gestalten.`, 'guide-text');
      window.scrollTo({top:0, behavior:'smooth'});
    } else {
      if (typeof sendToShopifyCart === 'function') sendToShopifyCart();
    }
  };

  window.display_title = document.getElementById('s5-display-title');
  window.physical_label = document.getElementById('s5-physical-label');

  if (document.readyState !== 'loading') initLabelStep();
  else document.addEventListener('DOMContentLoaded', initLabelStep);
</script>
