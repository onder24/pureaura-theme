{%- comment -%}
  Atramenti Produktkarte.
  Aufruf: {% render 'atr-card-product', product: product, badge: 'Neu' %}
{%- endcomment -%}

{%- liquid
  assign img = product.featured_media.preview_image
-%}

<a href="{{ product.url }}" class="atr-card">
  <div class="atr-media atr-media--portrait atr-card__media">
    {%- if img -%}
      {{
        img
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          class: 'atr-media__zoom',
          sizes: '(min-width: 990px) 30vw, 68vw',
          widths: '300,400,600,800',
          alt: img.alt | default: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'atr-media__zoom' }}
    {%- endif -%}

    {%- if badge != blank -%}
      <span class="atr-card__badge">{{ badge }}</span>
    {%- elsif product.available == false -%}
      <span class="atr-card__badge">Ausverkauft</span>
    {%- endif -%}
  </div>

  <div class="atr-card__body">
    <h3 class="atr-card__name">{{ product.title }}</h3>

    {%- assign note = product.metafields.atramenti.note | default: product.description | strip_html | truncatewords: 10 -%}
    {%- if note != blank -%}
      <p class="atr-subline" style="font-size: 13px;">{{ note }}</p>
    {%- endif -%}

    <p class="atr-meta">
      {{ product.price | money }}
      {%- if product.variants.first.title != 'Default Title' %} · {{ product.variants.first.title }}{% endif -%}
    </p>
  </div>
</a>
