{% comment %}
  ATRAMENTI TESTIMONIALS  ·  Forest & Amber

  Layout family: horizontal scroll-snap track. Section 4.9 names a carousel
  as the right component for breadth-heavy content, which six quotes are.

  Changed:
  - Removed the aggregate score block. It animated 0.0 up to 4.9 on scroll,
    which is decoration rather than communication, and it repeated the
    rating that the trust bar already carries one section above.
  - Removed the 5-second auto-scroll. It moved content while people were
    still reading it. Navigation is now explicit via buttons, drag, or
    keyboard, and the track is a focusable scroll region.
  - Monogram avatars used six different gradient colours (pink, teal,
    brass, blue). That breaks the one-accent rule, so they now share a
    single treatment.
  - Quotes trimmed to at most three lines each (Section 4.10).
  - Its own Google Fonts <link> removed; fonts are self-hosted globally.
{% endcomment %}

{%- liquid
  assign quotes = 'Zuhause gemischt, und es riecht wie echtes Nischen-Parfum. Das Ergebnis war umwerfend.|Lena P.|München|Single Set;;Als Geschenk für meine Frau ein absoluter Hit. Wir haben zusammen gemischt, ein unvergesslicher Abend.|Marco K.|Berlin|Duo Creation;;Die Qualität der Essenzen ist auf einem anderen Level. Ich bekomme ständig Komplimente.|Sophie B.|Hamburg|Single Set;;Team-Event für vier Personen. Jeder hat seinen eigenen Duft entwickelt, die Stimmung war fantastisch.|Jana R.|Frankfurt|Creative Circle;;Der Konfigurator ist durchdacht und intuitiv. In zehn Minuten stand meine Wunschformel.|Tim W.|Köln|Trio Essence;;Ich war skeptisch, ob man selbst hochwertig mischen kann. Nach dem ersten Versuch war ich begeistert.|Anna H.|Stuttgart|Single Set' | split: ';;'
-%}

<section class="atm atm-section atm-rev">
  <div class="atm-wrap">
    <header class="atm-rev-head atm-reveal">
      <div class="atm-rev-head-text">
        <p class="atm-eyebrow">Stimmen</p>
        <h2 class="atm-display atm-h2">
          Was unsere
          <strong>Alchemisten</strong>
          sagen.
        </h2>
      </div>

      <div class="atm-rev-controls">
        <button
          type="button"
          class="atm-rev-arrow"
          data-atm-rev-prev
          aria-label="Vorherige Bewertungen"
        >
          {% render 'atm-icon', name: 'arrow-right' %}
        </button>
        <button
          type="button"
          class="atm-rev-arrow"
          data-atm-rev-next
          aria-label="Weitere Bewertungen"
        >
          {% render 'atm-icon', name: 'arrow-right' %}
        </button>
      </div>
    </header>
  </div>

  <div
    class="atm-rev-track"
    data-atm-rev-track
    tabindex="0"
    role="group"
    aria-label="Kundenbewertungen, horizontal scrollbar"
  >
    {%- for entry in quotes -%}
      {%- assign parts = entry | split: '|' -%}
      {%- assign name = parts[1] -%}
      {%- assign words = name | split: ' ' -%}
      {%- assign first_initial = words[0] | slice: 0 -%}
      {%- assign last_initial = words[1] | slice: 0 -%}
      {%- assign initials = first_initial | append: last_initial -%}

      <figure class="atm-rev-card atm-reveal">
        <span class="atm-rev-mark">{% render 'atm-icon', name: 'quotes' %}</span>

        <div class="atm-rev-stars" aria-label="5 von 5 Sternen">
          {%- for i in (1..5) -%}
            {% render 'atm-icon', name: 'star-fill' %}
          {%- endfor -%}
        </div>

        <blockquote class="atm-rev-quote">{{ parts[0] }}</blockquote>

        <figcaption class="atm-rev-author">
          <span class="atm-rev-avatar" aria-hidden="true">{{ initials }}</span>
          <span class="atm-rev-author-text">
            <span class="atm-rev-name">{{ name }}</span>
            <span class="atm-rev-meta">{{ parts[2] }} · {{ parts[3] }}</span>
            <span class="atm-rev-verified">Verifizierter Kauf</span>
          </span>
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>

<style>
  .atm-rev {
    background: var(--atm-bg);
  }

  .atm-rev-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: clamp(36px, 4.5vw, 60px);
  }

  .atm-rev-head-text {
    max-width: 24ch;
  }

  .atm-rev-head .atm-eyebrow {
    margin: 0 0 14px;
  }

  .atm-rev-head h2 {
    margin: 0;
  }

  .atm-rev-controls {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .atm-rev-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    font-size: 18px;
    background: transparent;
    color: var(--atm-ink);
    border: 1px solid var(--atm-line-strong);
    border-radius: var(--atm-r-ctl);
    cursor: pointer;
    transition: border-color 0.25s var(--atm-ease), color 0.25s var(--atm-ease);
  }

  .atm-rev-arrow:hover:not(:disabled) {
    border-color: var(--atm-accent);
    color: var(--atm-accent);
  }

  .atm-rev-arrow:disabled {
    opacity: 0.32;
    cursor: default;
  }

  .atm-rev-arrow[data-atm-rev-prev] .atm-icon {
    transform: rotate(180deg);
  }

  /* Track. Bleeds to the right edge so the cut-off card signals more. */
  .atm-rev-track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 4px var(--atm-gutter) 28px;
    scrollbar-width: none;
  }

  .atm-rev-track::-webkit-scrollbar {
    display: none;
  }

  .atm-rev-track:focus-visible {
    outline: 2px solid var(--atm-accent);
    outline-offset: -2px;
  }

  .atm-rev-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: min(360px, 78vw);
    margin: 0;
    padding: 30px 28px 26px;
    background: var(--atm-bg-2);
    border: 1px solid var(--atm-line);
    border-radius: var(--atm-r);
    scroll-snap-align: start;
  }

  .atm-rev-mark {
    display: block;
    font-size: 22px;
    color: var(--atm-accent);
    opacity: 0.45;
    margin-bottom: 20px;
  }

  .atm-rev-stars {
    display: flex;
    gap: 3px;
    font-size: 14px;
    color: var(--atm-accent);
    margin-bottom: 16px;
  }

  .atm-rev-quote {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--atm-ink);
    flex-grow: 1;
  }

  .atm-rev-author {
    display: flex;
    align-items: center;
    gap: 13px;
    padding-top: 20px;
    border-top: 1px solid var(--atm-line);
  }

  .atm-rev-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    background: var(--atm-bg-3);
    border: 1px solid var(--atm-line-strong);
    border-radius: var(--atm-r-ctl);
    font-family: var(--atm-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--atm-accent);
  }

  .atm-rev-author-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .atm-rev-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--atm-ink);
  }

  .atm-rev-meta,
  .atm-rev-verified {
    font-size: 12px;
    color: var(--atm-ink-dim);
  }

  .atm-rev-verified {
    color: var(--atm-accent);
  }

  @media (max-width: 720px) {
    .atm-rev-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atm-rev-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  (function () {
    var track = document.querySelector('[data-atm-rev-track]');
    if (!track) return;

    var prev = document.querySelector('[data-atm-rev-prev]');
    var next = document.querySelector('[data-atm-rev-next]');
    var card = track.querySelector('.atm-rev-card');
    if (!prev || !next || !card) return;

    function step() {
      var gap = parseFloat(getComputedStyle(track).columnGap) || 18;
      return card.getBoundingClientRect().width + gap;
    }

    function sync() {
      var max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    }

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    next.addEventListener('click', function () {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });

    /* scroll on a scroll container is the event for reading its own
       position, not a window scroll listener. Throttled to a frame. */
    var queued = false;
    track.addEventListener(
      'scroll',
      function () {
        if (queued) return;
        queued = true;
        requestAnimationFrame(function () {
          queued = false;
          sync();
        });
      },
      { passive: true }
    );

    window.addEventListener('resize', sync, { passive: true });
    sync();
  })();
</script>

