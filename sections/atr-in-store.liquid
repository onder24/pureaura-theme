<div class="atr-scope atr-section atr-section--hairline">
  <div class="atr-container">
    <div class="atr-labelled">
      <div class="atr-instore__label">
        <span class="atr-label-vertical">{{ section.settings.label }}</span>
      </div>

      <div class="atr-labelled__body">
        <div class="atr-instore__grid">
          <div class="atr-stack atr-stack--md atr-instore__text">
            <h2 class="atr-h-display atr-h2">{{ section.settings.heading }}</h2>

            {%- if section.settings.subline != blank -%}
              <p class="atr-subline">{{ section.settings.subline }}</p>
            {%- endif -%}

            {%- if section.settings.body != blank -%}
              <div class="atr-body atr-body--muted atr-measure">{{ section.settings.body }}</div>
            {%- endif -%}

            {%- if section.blocks.size > 0 -%}
              <dl class="atr-instore__facts">
                {%- for block in section.blocks -%}
                  <div {{ block.shopify_attributes }}>
                    <dt class="atr-meta">{{ block.settings.label }}</dt>
                    <dd class="atr-body">{{ block.settings.value }}</dd>
                  </div>
                {%- endfor -%}
              </dl>
            {%- endif -%}

            {%- if section.settings.cta_label != blank -%}
              <div class="atr-row">
                <a href="{{ section.settings.cta_link | default: '#' }}" class="atr-btn atr-btn--solid">
                  {{ section.settings.cta_label }}
                </a>
              </div>
            {%- endif -%}
          </div>

          <div class="atr-instore__media">
            <div class="atr-media atr-media--landscape">
              {%- if section.settings.image_1 != blank -%}
                {{
                  section.settings.image_1
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 45vw, 90vw',
                    widths: '400,600,900,1200',
                    alt: section.settings.image_1.alt | default: section.settings.heading
                }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: '' }}
              {%- endif -%}
            </div>

            <div class="atr-media atr-media--portrait atr-instore__media-2">
              {%- if section.settings.image_2 != blank -%}
                {{
                  section.settings.image_2
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    widths: '300,500,700,900',
                    alt: section.settings.image_2.alt | default: section.settings.heading
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: '' }}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .atr-instore__label {
    flex: 0 0 auto;
    padding-top: 4px;
  }

  .atr-instore__grid {
    display: grid;
    gap: 40px;
  }

  .atr-instore__media {
    position: relative;
  }

  .atr-instore__media-2 {
    width: 45%;
    margin-top: -18%;
    margin-left: auto;
    border: 8px solid var(--atr-paper);
  }

  .atr-instore__facts {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--atr-mist);
  }

  .atr-instore__facts > div {
    padding: 14px 0;
    border-bottom: 1px solid var(--atr-mist);
  }

  .atr-instore__facts dd {
    margin: 0;
    font-size: 14px;
  }

  @media screen and (min-width: 990px) {
    .atr-instore__grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: center;
    }
  }
</style>

{% schema %}
{
  "name": "ATR In Store",
  "tag": "section",
  "class": "atr-section-instore",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Vertikales Randlabel",
      "default": "In Store Experiences"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Komm ins Atelier"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Kursive Subline",
      "default": "Neunzig Minuten, sechs Basen, eine Signatur."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Fließtext",
      "default": "<p>Im Atelier mischst du deinen Duft selbst — mit Beratung, Waage und Etikett. Am Ende gehst du mit einem Flakon, den es genau einmal gibt.</p>"
    },
    { "type": "image_picker", "id": "image_1", "label": "Bild groß" },
    { "type": "image_picker", "id": "image_2", "label": "Bild klein (überlappend)" },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Termin buchen" },
    { "type": "url", "id": "cta_link", "label": "Button-Link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Eckdaten",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Dauer" },
        { "type": "text", "id": "value", "label": "Wert", "default": "90 Minuten" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ATR In Store",
      "blocks": [
        { "type": "fact", "settings": { "label": "Dauer", "value": "90 Minuten" } },
        { "type": "fact", "settings": { "label": "Gruppengröße", "value": "Maximal 6 Personen" } },
        { "type": "fact", "settings": { "label": "Inklusive", "value": "50 ml Flakon zum Mitnehmen" } }
      ]
    }
  ]
}
{% endschema %}
