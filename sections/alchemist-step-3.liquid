const CAT_ICONS = {zitrisch:'◑',holzig:'⬡',blumig:'✦',orientalisch:'☽',frisch:'△',exotisch:'☉'};
const S3_MAX_TOTAL = 9, S3_MAX_PER = 3;
let s3ActiveCat = 'all';

/* ── HELPERS ── */
function s3GetSet() { const s=window.alchemistState; return s?.sets?.[s.currentActiveSet] || {oils:{}}; }
function s3Total()  { return Object.values(s3GetSet().oils||{}).reduce((a,b)=>a+b,0); }
function s3Drops(n) { return s3GetSet().oils?.[n]||0; }

/* ── FILTER ── */
function s3Filter(cat, btn) {
  s3ActiveCat = cat;
  document.querySelectorAll('.s3-filter-btn').forEach(b=>b.classList.toggle('active',b===btn));
  s3RenderGrid();
}

/* ── INFO OVERLAY TOGGLE (event delegation — reliable on iOS) ── */
function s3HideInfo(e, id) {
  e.stopPropagation();
  const el = document.getElementById('s3info_' + id);
  if (el) el.classList.remove('show');
}
function s3CloseAllInfo() {
  document.querySelectorAll('.s3-card-info.show').forEach(el => el.classList.remove('show'));
}
// Close overlays when tapping outside the grid
document.addEventListener('click', (e) => {
  if (!e.target.closest('#s3-grid')) s3CloseAllInfo();
});

/* ── CARD HTML ── */
function s3CardHTML(oil, idx) {
  const drops  = s3Drops(oil.name);
  const hasDrop = drops > 0;
  const tot    = s3Total();
  const addDis = drops >= S3_MAX_PER || tot >= S3_MAX_TOTAL;

  const imgEl = oil.img
    ? `<img class="s3-card-img" src="${oil.img}" alt="${oil.name}" loading="lazy" decoding="async" draggable="false" ondragstart="return false">`
    : `<div class="s3-card-ph">${CAT_ICONS[oil.cat]||'◈'}</div>`;

  const perfItems = (oil.perf||[]).slice(0,2).map((p, i) =>
    `<div class="s3-ov-item">
      <span class="s3-ov-n">0${i+1}</span>
      <div>
        <div class="s3-ov-pname">${p.n}</div>
        <div class="s3-ov-pbrand">${p.b}</div>
      </div>
    </div>`
  ).join('');

  return `<div class="s3-card${hasDrop?' selected has-drops':''}"
     data-name="${oil.name}" data-color="${oil.color}"
     style="animation-delay:${idx*.05}s">
    ${imgEl}
    <div class="s3-card-grad"></div>
    <div class="s3-card-cat">${CAT_ICONS[oil.cat]||'◈'} ${oil.cat}</div>
    <div class="s3-count-badge">${drops||''}</div>
    <div class="s3-card-name">${oil.name}</div>

    <!-- Info overlay — slides up from bottom -->
    <div class="s3-card-info" id="s3info_${oil.id}">
      <div class="s3-ov-stripe" style="background:${oil.color}"></div>
      <button class="s3-info-close" onclick="s3HideInfo(event,'${oil.id}')">✕</button>
      <div class="s3-ov-body">
        <p class="s3-ov-eyebrow">Bekannt aus</p>
        <h3 class="s3-ov-name">${oil.name}</h3>
        <div class="s3-ov-list">${perfItems}</div>
      </div>
    </div>

    <div class="s3-card-controls">
      <button class="s3-btn s3-btn-minus" onclick="s3Remove(event,'${oil.name}')"${!hasDrop?' disabled':''}>−</button>
      <button class="s3-btn s3-btn-plus"  onclick="s3QuickAdd(event,'${oil.name}')"${addDis?' disabled':''}>${hasDrop ? drops+'×' : 'Hinzufügen'}</button>
    </div>
  </div>`;
}

/* ── UPDATE SINGLE CARD (no rebuild) ── */
function s3UpdateCard(card, oil) {
  const drops  = s3Drops(oil.name);
  const hasDrop = drops > 0;
  const tot    = s3Total();
  const addDis = drops >= S3_MAX_PER || tot >= S3_MAX_TOTAL;

  card.classList.toggle('selected',  hasDrop);
  card.classList.toggle('has-drops', hasDrop);

  const badge = card.querySelector('.s3-count-badge');
  if (badge) badge.textContent = drops || '';

  const minus = card.querySelector('.s3-btn-minus');
  const plus  = card.querySelector('.s3-btn-plus');
  if (minus) minus.disabled = !hasDrop;
  if (plus)  {
    plus.disabled  = addDis;
    plus.textContent = hasDrop ? drops+'×' : 'Hinzufügen';
  }
}

/* ── RENDER GRID ── */
function s3RenderGrid(changedOilName) {
  const grid  = document.getElementById('s3-grid');
  const empty = document.getElementById('s3-empty');
  const oils  = S3_OILS.filter(o=>s3ActiveCat==='all'||o.cat===s3ActiveCat);
  if (!oils.length) { grid.innerHTML=''; empty.style.display='block'; return; }
  empty.style.display = 'none';

  const existing  = grid.querySelectorAll('.s3-card');
  const sameLayout = existing.length === oils.length &&
    Array.from(existing).every((el,i) => el.dataset.name === oils[i].name);

  if (sameLayout) {
    oils.forEach((oil,i) => {
      if (!changedOilName || oil.name===changedOilName || s3Total()>=S3_MAX_TOTAL || s3Total()===S3_MAX_TOTAL-1) {
        s3UpdateCard(existing[i], oil);
      }
    });
    return;
  }
  grid.innerHTML = oils.map((oil,idx) => s3CardHTML(oil,idx)).join('');
}

/* ── INTERACTIONS ── */
function s3QuickAdd(e, name) {
  e.stopPropagation();
  const set=s3GetSet(), cur=s3Drops(name), tot=s3Total();
  if (cur>=S3_MAX_PER||tot>=S3_MAX_TOTAL) {
    if (window.showToast) showToast(tot>=S3_MAX_TOTAL?'Maximum (9) erreicht':`Max. ${S3_MAX_PER} pro Öl`,'error');
    return;
  }
  set.oils[name] = cur+1;
  s3RenderGrid(name);
  s3UpdateMonitor(true);
}

function s3Remove(e, name) {
  e.stopPropagation();
  const set=s3GetSet();
  if (!set.oils[name]) return;
  set.oils[name]--;
  if (set.oils[name]<=0) delete set.oils[name];
  s3RenderGrid(name);
  s3UpdateMonitor(false);
}

/* ── MONITOR UPDATE ── */
function s3UpdateMonitor(added) {
  const set=s3GetSet(), tot=s3Total(), st=window.alchemistState;

  const totEl=document.getElementById('s3-total');
  if (totEl) totEl.innerText=tot;

  const fill=document.getElementById('s3-prog-fill');
  const glow=document.getElementById('s3-prog-glow');
  const pct=(tot/S3_MAX_TOTAL)*100;
  if (fill) fill.style.width=pct+'%';
  if (glow) { glow.style.opacity=tot>0?'1':'0'; glow.style.right=(100-pct)+'%'; }

  const dots=document.getElementById('s3-mon-dots');
  if (dots) dots.innerHTML=Array.from({length:S3_MAX_TOTAL},(_,i)=>{
    const on=i<tot, isNew=added&&i===tot-1;
    return `<div class="s3-drop-dot${on?' filled':''}${isNew?' new':''}"></div>`;
  }).join('');

  const row=document.getElementById('s3-selected-row');
  const keys=Object.keys(set.oils||{});
  if (row) {
    if (!keys.length) {
      row.innerHTML='<span class="s3-empty-hint">Wähle deine ersten Essenzen ↓</span>';
    } else {
      row.innerHTML=keys.map(n=>{
        const o=S3_OILS.find(x=>x.name===n);
        return `<div class="s3-chip"><div class="s3-chip-dot" style="background:${o?.color||'#4a9e74'}"></div><span class="s3-chip-name">${o?.id||n.substring(0,3)}</span><span class="s3-chip-qty">×${set.oils[n]}</span></div>`;
      }).join('');
    }
  }

  const badge=document.getElementById('s3-set-badge');
  const fin=document.getElementById('s3-finish-btn');
  const lbl=document.getElementById('s3-finish-label');
  if (badge&&st) badge.innerText='SET '+st.currentActiveSet;
  if (fin)  fin.disabled = tot < 1;
  if (lbl&&st) lbl.innerText=`SET ${st.currentActiveSet} SPEICHERN`;
}

/* ── INIT ── */
function initInventory() {
  if (!window.alchemistState) window.alchemistState={currentActiveSet:1,totalSets:1,sets:{1:{oils:{}}}};
  s3ActiveCat='all';
  document.querySelectorAll('.s3-filter-btn').forEach(b=>b.classList.toggle('active',b.dataset.cat==='all'));
  s3RenderGrid();
  s3UpdateMonitor(false);

  // Info overlay — event delegation on grid (single handler, works on iOS)
  const grid = document.getElementById('s3-grid');
  if (grid && !grid._tapReady) {
    grid._tapReady = true;
    grid.addEventListener('click', function(e) {
      // Buttons already call stopPropagation, so they never reach here
      if (e.target.closest('.s3-card-controls')) return;
      const card = e.target.closest('.s3-card');
      if (!card) return;
      const info = card.querySelector('.s3-card-info');
      if (!info) return;
      const isOpen = info.classList.contains('show');
      s3CloseAllInfo();
      if (!isOpen) info.classList.add('show');
    });
  }
}

initInventory();
</script>
