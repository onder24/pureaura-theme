   perf:[{n:'Opium',b:'YSL'},{n:'Obsession',b:'Calvin Klein'},{n:'Coco',b:'Chanel'}]},
  {id:'BW',name:'Balsam Wood',       cat:'holzig',      color:'#8a6040',img:'{{ "oil-balsam-wood.png" | asset_url }}',
   perf:[{n:'Ambre Gris',b:'Hermès'},{n:'Baume du Doge',b:'Lorenzo Villoresi'},{n:'Santal Blush',b:'Tom Ford'}]},
  {id:'AN',name:'Ananas',            cat:'exotisch',    color:'#f0c830',img:'{{ "oil-ananas.png" | asset_url }}',
   perf:[{n:'L\'Homme',b:'YSL'},{n:'Polo Red',b:'Ralph Lauren'},{n:'Eros',b:'Versace'}]},
  {id:'WS',name:'Weißes Sandelholz', cat:'holzig',      color:'#e0c8a0',img:'{{ "oil-weisses-sandelholz.png" | asset_url }}',
   perf:[{n:'Santal 33',b:'Le Labo'},{n:'Tam Dao',b:'Diptyque'},{n:'Santal Blush',b:'Tom Ford'}]},
