{%- liquid
  assign list = linklists[section.settings.menu]
  assign has_menu = false
  if list.links.size > 0
    assign has_menu = true
  endif
-%}

<div class="atr-scope atr-header{% if section.settings.sticky %} atr-header--sticky{% endif %}">
  <div class="atr-container">
    <div class="atr-header__inner">
      <div class="atr-header__left">
        <button
          class="atr-header__burger"
          type="button"
          aria-label="Menü öffnen"
          aria-expanded="false"
          aria-controls="atr-menu"
          data-atr-burger
        >
          <span></span><span></span>
        </button>
      </div>

      <a href="{{ routes.root_url }}" class="atr-header__logo">
        <span class="atr-header__wordmark">{{ section.settings.logo_text | default: shop.name }}</span>
        {%- if section.settings.tagline != blank -%}
          <span class="atr-header__tagline">{{ section.settings.tagline }}</span>
        {%- endif -%}
      </a>

      <div class="atr-header__right">
        <button
          class="atr-header__icon"
          type="button"
          aria-label="Suche öffnen"
          aria-expanded="false"
          aria-controls="atr-search"
          data-atr-search-toggle
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1"></circle>
            <line x1="12.2" y1="12.2" x2="16.5" y2="16.5" stroke="currentColor" stroke-width="1"></line>
          </svg>
        </button>

        <a href="{{ routes.cart_url }}" class="atr-header__icon atr-header__cart" aria-label="Warenkorb">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 5.5h11l-1 10.5h-9l-1-10.5Z" stroke="currentColor" stroke-width="1"></path>
            <path d="M6.5 7.5V4.75a2.5 2.5 0 0 1 5 0V7.5" stroke="currentColor" stroke-width="1"></path>
          </svg>
          <span class="atr-header__count" data-atr-cart-count>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} Suchfeld, klappt unter dem Header aus {%- endcomment -%}
  <div class="atr-header__search" id="atr-search" data-atr-search hidden>
    <form action="{{ routes.search_url }}" method="get" role="search" class="atr-container atr-header__searchform">
      <label class="atr-visually-hidden" for="atr-search-input">Suche</label>
      <input
        id="atr-search-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.search_placeholder }}"
        class="atr-header__searchinput"
      >
      <button type="button" class="atr-header__searchclose" data-atr-search-close>Schließen</button>
    </form>
  </div>
</div>

{%- comment -%} Fullscreen-Overlay, faehrt von links ein {%- endcomment -%}
<div
  class="atr-scope atr-menu"
  id="atr-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Hauptmenü"
  aria-hidden="true"
  data-atr-menu
>
  <div class="atr-container atr-menu__inner">
    <div class="atr-menu__bar">
      <span class="atr-menu__tagline">{{ section.settings.tagline }}</span>
      <button class="atr-header__icon" type="button" aria-label="Menü schließen" data-atr-menu-close>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
          <line x1="2" y1="2" x2="16" y2="16" stroke="currentColor" stroke-width="1"></line>
          <line x1="16" y1="2" x2="2" y2="16" stroke="currentColor" stroke-width="1"></line>
        </svg>
      </button>
    </div>

    <nav class="atr-menu__nav" aria-label="Hauptnavigation">
      {%- if has_menu -%}
        {%- for link in list.links -%}
          <a href="{{ link.url }}" class="atr-menu__link">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          Fallback, solange im Shopify-Admin kein passendes Menü hinterlegt ist.
          Entspricht der Navigation im Next.js-Referenzprojekt.
        {%- endcomment -%}
        <a href="{{ routes.collections_url }}/signature" class="atr-menu__link">Signature-Düfte</a>
        <a href="{{ routes.collections_url }}/date-night-set" class="atr-menu__link">Date-Night-Set</a>
        <a href="/pages/hochzeit" class="atr-menu__link">Hochzeit</a>
        <a href="/pages/workshops" class="atr-menu__link">Workshops</a>
        <a href="/pages/firmenevents" class="atr-menu__link">Firmenevents</a>
        <a href="/pages/ueber-uns" class="atr-menu__link">Über Atramenti</a>
      {%- endif -%}
    </nav>
  </div>
</div>

<style>
  .atr-header {
    background-color: var(--atr-paper);
    border-bottom: 1px solid var(--atr-mist);
  }

  .atr-header--sticky {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .atr-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 64px;
    gap: 16px;
  }

  .atr-header__left {
    justify-self: start;
  }

  .atr-header__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* Wortmarke mit Subline */
  .atr-header__logo {
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: var(--atr-ink);
  }

  .atr-header__wordmark {
    text-transform: uppercase;
    letter-spacing: var(--atr-tracking-wide2);
    font-size: 14px;
    line-height: 1;
  }

  .atr-header__tagline {
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 9px;
    line-height: 1;
    color: var(--atr-muted);
  }

  .atr-header__burger {
    background: none;
    border: 0;
    padding: 12px 0;
    cursor: pointer;
    width: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .atr-header__burger span {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--atr-ink);
  }

  .atr-header__icon {
    background: none;
    border: 0;
    padding: 4px;
    cursor: pointer;
    color: var(--atr-ink);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .atr-header__count {
    font-size: 12px;
    letter-spacing: var(--atr-tracking-widest);
    font-variant-numeric: tabular-nums;
  }

  /* Suchfeld */
  .atr-header__search {
    border-top: 1px solid var(--atr-mist);
  }

  .atr-header__searchform {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
  }

  .atr-header__searchinput {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--atr-mist);
    border-radius: 0;
    padding-bottom: 8px;
    font-family: var(--atr-font);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: var(--atr-tracking-widest);
    color: var(--atr-ink);
  }

  .atr-header__searchinput:focus {
    outline: none;
    border-bottom-color: var(--atr-ink);
  }

  .atr-header__searchclose {
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--atr-font);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: var(--atr-tracking-widest);
    color: var(--atr-muted);
    white-space: nowrap;
  }

  /* Overlay */
  .atr-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--atr-paper);
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    overflow-y: auto;
  }

  .atr-menu.is-open {
    transform: translateX(0);
  }

  .atr-menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .atr-menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .atr-menu__tagline {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 9px;
    color: var(--atr-muted);
  }

  .atr-menu__nav {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--atr-mist);
  }

  .atr-menu__link {
    padding-block: 24px;
    border-bottom: 1px solid var(--atr-mist);
    text-decoration: none;
    color: var(--atr-ink);
    text-transform: uppercase;
    letter-spacing: var(--atr-tracking-widest);
    font-size: 20px;
    transition: opacity 0.3s ease;
  }

  .atr-menu__link:hover {
    opacity: 0.5;
  }

  @media screen and (min-width: 750px) {
    .atr-header__wordmark {
      font-size: 16px;
    }

    .atr-menu__link {
      font-size: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atr-menu {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    var burger = document.querySelector('[data-atr-burger]');
    var menu = document.querySelector('[data-atr-menu]');
    var menuClose = document.querySelector('[data-atr-menu-close]');
    var searchToggle = document.querySelector('[data-atr-search-toggle]');
    var search = document.querySelector('[data-atr-search]');
    var searchClose = document.querySelector('[data-atr-search-close]');
    var searchInput = document.getElementById('atr-search-input');

    function openMenu() {
      if (!menu) return;
      menu.classList.add('is-open');
      menu.setAttribute('aria-hidden', 'false');
      if (burger) burger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (!menu) return;
      menu.classList.remove('is-open');
      menu.setAttribute('aria-hidden', 'true');
      if (burger) burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    function toggleSearch(force) {
      if (!search) return;
      var open = typeof force === 'boolean' ? force : search.hidden;
      search.hidden = !open;
      if (searchToggle) searchToggle.setAttribute('aria-expanded', String(open));
      if (open && searchInput) searchInput.focus();
    }

    if (burger) burger.addEventListener('click', openMenu);
    if (menuClose) menuClose.addEventListener('click', closeMenu);
    if (searchToggle) {
      searchToggle.addEventListener('click', function () {
        toggleSearch();
      });
    }
    if (searchClose) {
      searchClose.addEventListener('click', function () {
        toggleSearch(false);
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      closeMenu();
      toggleSearch(false);
    });
  })();
</script>

{% schema %}
{
  "name": "ATR Header",
  "tag": "header",
  "class": "atr-section-header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Wortmarke",
      "default": "ATRAMENTI"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Subline unter der Wortmarke",
      "default": "EXPERIMENTAL INK PERFUMERY"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü für das Overlay",
      "info": "Leer lassen, um die eingebaute Standardnavigation zu verwenden."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Platzhalter im Suchfeld",
      "default": "WONACH SUCHST DU?"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Header fixiert",
      "default": true
    }
  ]
}
{% endschema %}
