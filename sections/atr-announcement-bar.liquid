{%- liquid
  assign msgs = section.blocks | where: 'type', 'message'
-%}

<div class="atr-scope atr-announce{% if section.settings.dark %} atr-announce--dark{% endif %}">
  <div class="atr-container">
    <div class="atr-announce__inner">
      {%- if msgs.size > 0 -%}
        <div class="atr-announce__track" data-atr-announce data-interval="{{ section.settings.interval }}">
          {%- for block in msgs -%}
            <div
              class="atr-announce__item{% if forloop.first %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .atr-announce {
    background-color: var(--atr-sand);
    color: var(--atr-ink);
    border-bottom: 1px solid var(--atr-mist);
    font-size: 11px;
    letter-spacing: var(--atr-tracking-wide2);
    text-transform: uppercase;
  }

  .atr-announce--dark {
    background-color: var(--atr-ink);
    color: var(--atr-paper);
    border-bottom-color: var(--atr-ink);
  }

  .atr-announce__inner {
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 8px;
  }

  /*
   * Grid statt absoluter Positionierung: alle Meldungen liegen in derselben
   * Zelle uebereinander (Crossfade bleibt), die Hoehe waechst aber mit der
   * laengsten Meldung mit. Auf schmalen Schirmen darf der Text umbrechen,
   * ohne aus der Leiste zu laufen.
   */
  .atr-announce__track {
    display: grid;
    width: 100%;
  }

  .atr-announce__item {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .atr-announce__item.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .atr-announce__item a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .atr-announce__item {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .atr-announce {
      font-size: 10px;
      letter-spacing: 0.15em;
    }
  }
</style>

<script>
  (function () {
    var track = document.querySelector('[data-atr-announce]');
    if (!track) return;
    var items = track.querySelectorAll('.atr-announce__item');
    if (items.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var i = 0;
    var interval = parseInt(track.dataset.interval, 10) || 5;

    setInterval(function () {
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    }, interval * 1000);
  })();
</script>

{% schema %}
{
  "name": "ATR Announcement Bar",
  "tag": "section",
  "class": "atr-section-announce",
  "settings": [
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Helle Variante (Sand statt Schwarz)",
      "default": false
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Wechselintervall",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Nachricht",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Beginner-Workshop: nächster Live-Termin im Oktober"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ATR Announcement Bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Beginner-Workshop: nächster Live-Termin im Oktober → Platz sichern",
            "link": "/pages/workshops"
          }
        }
      ]
    }
  ]
}
{% endschema %}
